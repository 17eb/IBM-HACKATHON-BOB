# Dev toolchain: GnuCOBOL 3.2 + JDK 21 (targets Java 17) + Python with the MCP SDK.
FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends gnucobol3 openjdk-21-jdk-headless python3 python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir mcp==1.30.0 pytest streamlit
ENV PATH=/opt/venv/bin:$PATH \
    HOME=/tmp
WORKDIR /work
